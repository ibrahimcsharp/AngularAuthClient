{

    "version": "0.2.0",
     "configurations": [
        {
            "name": "ng serve",
            "type": "pwa-chrome",
            "request": "launch",
            "url": "http://localhost:4200",
            "webRoot": "${workspaceFolder}/src/app",
            "preLaunchTask": "npm: start",
            "sourceMaps": true,
            "trace": true
        },
        {
            "name": "ng test",
            "type": "pwa-chrome",
            "request": "launch",
            "url": "http://localhost:9876",
            "webRoot": "${workspaceFolder}",
            "preLaunchTask": "npm: test",
            "sourceMaps": true,
            "trace": true
        }
    ]
}